# Copy to .env and adjust. All values below are the template defaults.

# Database / security
DATABASE_URL=sqlite:///./app.db
SECRET_KEY=dev-secret-change-me

# Adapter selection: payment=mock|wechat, generation=mock|deepseek
PAYMENT_GATEWAY=mock
GENERATION_ADAPTER=mock

# DeepSeek (self-owned generation; replaceable underlying LLM)
# Key is user-supplied; never commit it. See .env.deepseek.howto.md
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Credits
CREDIT_EXPIRE_DAYS=730
RENEW_MODE=all_active
REFUND_MODE=unused_only

# Affiliate / withdrawal
COMMISSION_OBSERVATION_DAYS=15
MIN_WITHDRAW_FEN=10000
SELF_REFERRAL_CHECK=off

# Compliance / sharing
AIGC_LABEL=true
AUDIT_RETENTION_DAYS=190
SHARE_LINK_TTL_DAYS=7

# Auth / worker
VERIFY_CODE_DEV=123456
WORKER_POLL_SEC=5
